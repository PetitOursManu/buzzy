# ─────────────────────────────────────────────────────────────────
# Buzzy — variables d'environnement
#
# Démarrage le plus simple :
#   cp .env.example .env && docker compose up -d --build
#
# Pour développer hors conteneur, `npm run setup` génère ce fichier
# tout seul, avec de vrais secrets aléatoires.
# ─────────────────────────────────────────────────────────────────

# ─── Base de données ─────────────────────────────────────────────
# En Docker Compose, l'hôte est le service « db ».
# En développement local (npm run dev), utilisez « localhost ».
DATABASE_URL=postgresql://buzzy:buzzy@db:5432/buzzy

# Identifiants du conteneur PostgreSQL. DATABASE_URL en découle
# automatiquement dans docker-compose.yml : ne changer que le mot de
# passe suffit, les deux restent cohérents.
POSTGRES_USER=buzzy
POSTGRES_PASSWORD=buzzy
POSTGRES_DB=buzzy

# ─── Sécurité (À CHANGER IMPÉRATIVEMENT) ─────────────────────────
# Le serveur REFUSE de démarrer en production avec ces valeurs par défaut.
# Générer : openssl rand -hex 32

# Secret de signature des JWT.
JWT_SECRET=change-me

# Clé de chiffrement AES-256-GCM des secrets stockés en base (clé API du
# fournisseur IA, en-têtes d'authentification MCP). 32 octets : 64 caractères
# hex, 32 caractères bruts, ou base64. Toute autre valeur est dérivée en
# SHA-256 — la changer rend les secrets déjà enregistrés indéchiffrables.
ENCRYPTION_KEY=change-me-32-bytes-long-secret!!

# ─── Compte administrateur (créé au premier démarrage) ───────────
# Le mot de passe est hashé en argon2id ; il n'est lu qu'à la création du
# compte. Pour le modifier ensuite : Paramètres → Compte & sécurité.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ─── Serveur ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Délais ──────────────────────────────────────────────────────
# La découverte d'événements s'exécute en tâche de fond : la requête HTTP
# rend la main aussitôt, donc AUCUN délai de proxy ne s'y applique (ni les
# 100 s de Cloudflare, ni ceux de Traefik ou nginx).
#
# Budget total d'une génération, en millisecondes (défaut : 240000).
# Sert uniquement à éviter une tâche qui ne finirait jamais.
# BUZZY_GENERATION_TIMEOUT_MS=240000

# Délai d'un appel individuel au modèle (défaut : 80000).
# Volontairement sous les 100 s de Cloudflare : les routes encore synchrones
# (plan, textes par réseau, régénération d'une publication) doivent répondre
# avant qu'il ne coupe.
# AI_REQUEST_TIMEOUT_MS=80000

# Délai d'un appel d'outil MCP, ex. le chargement d'une page (défaut : 25000).
# MCP_TOOL_TIMEOUT_MS=25000

# Plafond de jetons demandé au modèle (défaut : 8000). En dessous, la réponse
# JSON est coupée en plein milieu : les événements complets sont conservés,
# les derniers sont perdus. À augmenter si vous demandez beaucoup d'événements
# avec une description par réseau social.
# AI_MAX_TOKENS=8000

# Origine autorisée pour CORS. Nécessaire uniquement en développement, quand
# le frontend Vite (5173) et l'API (3000) sont sur des origines distinctes.
# En production, le même serveur sert les deux : laisser vide.
# CORS_ORIGIN=http://localhost:5173

# ─── Recherche web MCP (auto-hébergée, incluse dans la stack) ────
# Ces trois serveurs sont déployés par docker-compose.yml et pré-enregistrés
# DÉSACTIVÉS au démarrage. Il suffit de les cocher « Actif » dans
# Paramètres → Recherche Web (MCP). Aucune clé API, 100 % gratuit.
#
# Laisser une valeur vide pour ne pas pré-enregistrer le serveur concerné.
SEARXNG_MCP_URL=http://searxng-mcp:8000/mcp
MCP_FETCH_URL=http://mcp-fetch:8000/mcp
MCP_TIME_URL=http://mcp-time:8000/mcp

# Secret interne de SearXNG (n'importe quelle chaîne longue).
SEARXNG_SECRET=change-me-searxng-secret-0123456789

# Fuseau horaire renvoyé par le serveur MCP « Time ».
LOCAL_TIMEZONE=Europe/Paris
