# ─── Base de données ─────────────────────────────────────────────
# URL de connexion PostgreSQL. En Docker Compose, l'hôte est le service "db".
DATABASE_URL=postgresql://buzzy:buzzy@db:5432/buzzy

# ─── Sécurité ────────────────────────────────────────────────────
# Secret de signature des JWT (change-moi, chaîne aléatoire longue).
JWT_SECRET=change-me

# Clé de chiffrement AES-256-GCM des secrets stockés en base
# (clé API IA, en-têtes d'auth MCP). DOIT faire 32 octets.
# Peut être une chaîne de 32 caractères OU une valeur hex de 64 caractères
# OU une valeur base64. Générer par ex. : openssl rand -hex 32
ENCRYPTION_KEY=change-me-32-bytes-long-secret!!

# ─── Compte administrateur (créé au premier démarrage) ───────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ─── Serveur ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Origine autorisée pour CORS en développement (frontend Vite).
# En production, le frontend est servi par le même serveur : laisser vide.
# CORS_ORIGIN=http://localhost:5173

# ─── Recherche web MCP auto-hébergée (SearXNG, optionnel) ────────
# Pour activer la recherche web SearXNG (services searxng + searxng-mcp),
# décommentez CES DEUX lignes. Fonctionne aussi bien en local que sur
# Coolify (à définir alors dans l'UI Coolify).
#   - COMPOSE_PROFILES active les services derrière le profil « searxng »
#   - SEARXNG_MCP_URL pré-enregistre le serveur MCP dans Buzzy (désactivé)
# COMPOSE_PROFILES=searxng
# SEARXNG_MCP_URL=http://searxng-mcp:8000/mcp
